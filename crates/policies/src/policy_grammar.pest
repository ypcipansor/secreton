// Policy language grammar for Secreton
// Domain-Specific Language for Access Control Policies

policy = { SOI ~ policy_header ~ rule_block* ~ EOI }

policy_header = { "policy" ~ identifier ~ "{" }

rule_block = { "rule" ~ identifier ~ "{" ~ condition_block* ~ action_block? ~ resource_block? ~ "}" }

condition_block = { "condition" ~ "{" ~ condition+ ~ "}" }

condition = { attribute ~ operator ~ value_list }

attribute = { identifier ~ ("." ~ identifier)* }

operator = {
    "==" |
    "!=" |
    "contains" |
    "not_contains" |
    "in" |
    "not_in" |
    ">" |
    "<" |
    "regex"
}

value_list = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

value = { string | number | boolean | identifier }

action_block = { "actions" ~ "=" ~ "[" ~ (string ~ ("," ~ string)*)? ~ "]" }

resource_block = { "resources" ~ "=" ~ "[" ~ (string ~ ("," ~ string)*)? ~ "]" }

string = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

number = { ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

boolean = { "true" | "false" }

identifier = { (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = { " " | "\t" | "\n" | "\r" }

COMMENT = { "//" ~ (!"\n" ~ ANY)* ~ "\n" }