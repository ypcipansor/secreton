# Server configuration
SECRETON_SERVER__HOST=127.0.0.1
SECRETON_SERVER__PORT=8080
SECRETON_SERVER__LOG_LEVEL=info
SECRETON_SERVER__STORAGE_PATH=./data

# Database configuration
SECRETON_DATABASE__URL=sqlite:./data/secreton.db
SECRETON_DATABASE__MAX_CONNECTIONS=5

# Authentication configuration
SECRETON_AUTH__TOKEN_TTL=3600
SECRETON_AUTH__REFRESH_TOKEN_TTL=2592000
SECRETON_AUTH__JWT_SECRET=change-this-to-a-secure-random-string
