# Copy to .env and fill in. .env is gitignored.

# Required. Minimum 32 bytes; startup refuses a shorter one, and never generates
# a secret automatically — one invented at boot invalidates every issued token on
# the next restart.
#   openssl rand -base64 48
SECRETON_JWT_SECRET=

# Required by compose.
POSTGRES_PASSWORD=
POSTGRES_USER=secreton
POSTGRES_DB=secreton

# Optional
RUST_LOG=info
